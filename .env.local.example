# ═══════════════════════════════════════════════════════════════════════════════
# Eventrip — Variables d'environnement
# Copiez ce fichier en `.env.local` et remplissez les valeurs.
# JAMAIS committer .env.local (déjà dans .gitignore).
#
# Règle sécurité :
#   - Préfixe NEXT_PUBLIC_ → exposé au navigateur (safe si pas de secret)
#   - Sans préfixe → serveur uniquement (clés secrètes API)
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Ticketmaster Discovery API ─────────────────────────────────────────────
# Inscription GRATUITE (pas de CB) : developer.ticketmaster.com
# Quota : 5 000 requêtes/jour · Clé dispo immédiatement
# ⚠️  Sans NEXT_PUBLIC_ → utilisée seulement côté serveur (API routes)
TICKETMASTER_API_KEY=votre_cle_ticketmaster

# ─── Amadeus Self-Service API ────────────────────────────────────────────────
# Inscription GRATUITE : developers.amadeus.com/self-service
# Sandbox gratuit avec données réelles de test
AMADEUS_CLIENT_ID=votre_client_id_amadeus
AMADEUS_CLIENT_SECRET=votre_client_secret_amadeus
AMADEUS_ENV=test   # "test" = sandbox | "prod" = production

# ─── Supabase ────────────────────────────────────────────────────────────────
# Tier gratuit : 500MB base, 50k authentifications/mois
# Créer un projet : supabase.com
# Exécuter supabase-schema.sql dans SQL Editor après création
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...    # clé anonyme (safe publique via RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...         # ⚠️ admin — serveur uniquement

# ─── Stripe (paiement — phase 2) ────────────────────────────────────────────
# dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
