# ═══════════════════════════════════════════════════════════════════════════════
# Eventrip — Variables d'environnement
# Copiez ce fichier en `.env.local` et remplissez les valeurs réelles.
# JAMAIS committer .env.local (déjà dans .gitignore).
#
# Règles sécurité :
#   - NEXT_PUBLIC_* → exposé au navigateur (utiliser pour données publiques uniquement)
#   - Sans préfixe → serveur uniquement (clés API secrètes)
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Duffel API (Vols + Trains) ───────────────────────────────────────────────
# Inscription gratuite : duffel.com/developers
# Sandbox gratuit avec test account
# Dashboard : https://app.duffel.com/developers/api-keys
DUFFEL_API_KEY=sk_live_xxxxx_or_sk_test_xxxxx

# ─── Booking.com Partner API ──────────────────────────────────────────────────
# Inscription partenaire : partner.booking.com
# Obtenir : API Key + Secret
# Affiliate ID optionnel pour tracking
BOOKING_API_KEY=votre_booking_api_key
BOOKING_API_SECRET=votre_booking_api_secret
BOOKING_AFFILIATE_ID=booking

# ─── Ticketmaster Discovery API ────────────────────────────────────────────────
# Inscription GRATUITE (pas de CB) : developer.ticketmaster.com
# Quota : 5 000 requêtes/jour
# Clé disponible immédiatement après inscription
TICKETMASTER_API_KEY=votre_cle_ticketmaster

# ─── Supabase (Base de données + Auth) ─────────────────────────────────────────
# Création gratuite : supabase.com
# Tier gratuit : 500MB base de données, 50k authentifications/mois
#
# Après création du projet :
# 1. Copier l'URL du projet (Settings > General)
# 2. Copier la clé anon (Settings > API)
# 3. Copier la clé service role (Settings > API)
# 4. Exécuter init-db.sql dans l'éditeur SQL Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Stripe (Paiement) ──────────────────────────────────────────────────────────
# Compte Stripe gratuit : stripe.com
# Clés de test : https://dashboard.stripe.com/test/apikeys
# Mode test vs production via clés différentes
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx_or_pk_live_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx_or_sk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ─── Application ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
NODE_ENV=development

# ─── Email (optionnel) ─────────────────────────────────────────────────────────
# Pour confirmations, notifications
# Exemple avec Resend (gratuit) : resend.com
RESEND_API_KEY=re_xxxxx
NEXT_PUBLIC_SUPPORT_EMAIL=support@eventrip.com

# ─── Analytics (optionnel) ────────────────────────────────────────────────────
# Supabase a Google Analytics natif
# Ou utiliser Posthog, Plausible, etc.
NEXT_PUBLIC_ANALYTICS_ID=xxxxx
